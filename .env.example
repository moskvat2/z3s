# ==============================================================================
# Z3S Object Storage - Configurações de Ambiente
# ==============================================================================

# Credenciais de Administrador S3
Z3S_ACCESS_KEY=Z3SACCESSKEYEXAMPLE
Z3S_SECRET_KEY=Z3SSECRETKEYEXAMPLE1234567890ABCDEF

# Porta de Bind do Gateway HTTP
Z3S_PORT=9000
Z3S_BIND=0.0.0.0:9000

# Diretório Interno de Dados
Z3S_DATA_DIR=/data

# Configuração de Erasure Coding (Reed-Solomon)
Z3S_DATA_SHARDS=4
Z3S_PARITY_SHARDS=2
